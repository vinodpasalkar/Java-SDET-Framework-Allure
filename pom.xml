<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven project definition. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Maven model version. --><modelVersion>4.0.0</modelVersion>
  <!-- Project coordinates. --><groupId>com.nageshg</groupId><artifactId>java-sdet-framework</artifactId><version>1.0.0</version>
  <!-- Shared build properties. --><properties>
    <!-- Java language level. --><maven.compiler.release>17</maven.compiler.release>
    <!-- File encoding. --><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Library versions. --><cucumber.version>7.20.1</cucumber.version><selenium.version>4.27.0</selenium.version>
  </properties>
  <!-- Test dependencies. --><dependencies>
    <!-- Browser automation. --><dependency><groupId>org.seleniumhq.selenium</groupId><artifactId>selenium-java</artifactId><version>${selenium.version}</version><scope>test</scope></dependency>
    <!-- Cucumber step definitions. --><dependency><groupId>io.cucumber</groupId><artifactId>cucumber-java</artifactId><version>${cucumber.version}</version><scope>test</scope></dependency>
    <!-- Cucumber JUnit Platform engine. --><dependency><groupId>io.cucumber</groupId><artifactId>cucumber-junit-platform-engine</artifactId><version>${cucumber.version}</version><scope>test</scope></dependency>
    <!-- Scenario dependency injection. --><dependency><groupId>io.cucumber</groupId><artifactId>cucumber-picocontainer</artifactId><version>${cucumber.version}</version><scope>test</scope></dependency>
    <!-- JUnit suite API. --><dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-suite</artifactId><version>1.11.4</version><scope>test</scope></dependency>
    <!-- REST API testing. --><dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><version>5.5.0</version><scope>test</scope></dependency>
    <!-- Local mock API server. --><dependency><groupId>org.wiremock</groupId><artifactId>wiremock</artifactId><version>3.10.0</version><scope>test</scope></dependency>
    <!-- JUnit Jupiter. --><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
    <!-- Allure adapter for Cucumber 7 scenarios and attachments. --><dependency><groupId>io.qameta.allure</groupId><artifactId>allure-cucumber7-jvm</artifactId><version>2.29.1</version><scope>test</scope></dependency>
    <!-- Allure adapter for JUnit 5 tests such as the REST Assured API test. --><dependency><groupId>io.qameta.allure</groupId><artifactId>allure-junit5</artifactId><version>2.29.1</version><scope>test</scope></dependency>
  </dependencies>
  <!-- Build plugins. --><build><plugins>
    <!-- Compiles Java 17 source. --><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><release>17</release></configuration></plugin>
    <!-- Runs JUnit Platform tests. -->
    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-surefire-plugin</artifactId>
      <version>3.5.2</version>
      <configuration>
        <useModulePath>false</useModulePath>
        <systemPropertyVariables>
          <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
        </systemPropertyVariables>
      </configuration>
    </plugin>
    <!-- Generates and serves Allure HTML reports. -->
    <plugin>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-maven</artifactId>
      <version>2.12.0</version>
      <configuration>
        <reportVersion>2.29.1</reportVersion>
        <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
      </configuration>
    </plugin>
  </plugins></build>
</project>
